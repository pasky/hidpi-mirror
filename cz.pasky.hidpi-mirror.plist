<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>cz.pasky.hidpi-mirror</string>
	<key>ProgramArguments</key>
	<array>
		<!-- Adjust the path to wherever you built hidpi-mirror,
		     and the size to your preferred "looks like" resolution.
		     Optional third argument: display vendor id (default Dell). -->
		<string>/Users/YOURUSERNAME/src/hidpi-mirror/hidpi-mirror</string>
		<string>2048</string>
		<string>1152</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Exempt from background throttling / App Nap: the display watchdog
	     poll must keep running even after days of idling and sleep. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>KeepAlive</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>StandardOutPath</key>
	<string>/tmp/hidpi-mirror.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/hidpi-mirror.log</string>
</dict>
</plist>
